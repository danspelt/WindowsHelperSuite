<Window x:Class="StillSpace.CorrectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Transcript correction"
        Width="480"
        SizeToContent="Height"
        Background="#0F1218"
        Foreground="#E8EAEF"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171B24" />
            <Setter Property="Foreground" Value="#E8EAEF" />
            <Setter Property="BorderBrush" Value="#2A3140" />
            <Setter Property="CaretBrush" Value="#E8EAEF" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock Text="What STT heard (mistaken)" Foreground="#9AA3B5" FontSize="11" />
        <TextBox x:Name="MistakenBox"
                 IsReadOnly="True"
                 MinHeight="60"
                 Margin="0,4,0,12" />
        <TextBlock Text="What you meant" Foreground="#9AA3B5" FontSize="11" />
        <TextBox x:Name="CorrectedBox"
                 MinHeight="60"
                 Margin="0,4,0,16" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Save" Width="90" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </StackPanel>
</Window>
