<Window x:Class="StillSpace.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Still Space — Settings"
        Width="520"
        SizeToContent="Height"
        MinHeight="420"
        Background="#0F1218"
        Foreground="#E8EAEF"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#171B24" />
            <Setter Property="Foreground" Value="#E8EAEF" />
            <Setter Property="BorderBrush" Value="#2A3140" />
            <Setter Property="CaretBrush" Value="#E8EAEF" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Foreground" Value="#E8EAEF" />
        </Style>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="0">
            <StackPanel>
                <TextBlock Text="OpenAI API key (optional if set in .env / environment)" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="ApiKeyBox" />

                <TextBlock Text="Preferred name (prepended to messages)" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="PreferredNameBox" />

                <TextBlock Text="Speech language (e.g. en-US)" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="SttLangBox" />

                <CheckBox x:Name="AiDictationHintsBox"
                          Content="Writing-assistant next-word hints while dictating (not the counselor; chat API; off during live voice)" />
                <TextBlock Text="Hint model (empty = gpt-4o-mini; or set OPENAI_HINT_MODEL)" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="HintModelBox" />

                <TextBlock Text="Pause before reply (ms)" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="PauseMsBox" />

                <TextBlock Text="Chat model" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="ChatModelBox" />

                <TextBlock Text="TTS model" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="TtsModelBox" />

                <TextBlock Text="TTS voice (alloy, echo, fable, onyx, nova, shimmer)" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="TtsVoiceBox" />

                <TextBlock Text="Realtime model (live voice; empty = gpt-realtime)" Foreground="#9AA3B5" FontSize="11" Margin="0,12,0,0" />
                <TextBox x:Name="RealtimeModelBox" />

                <TextBlock Text="Realtime voice (e.g. marin, alloy)" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="RealtimeVoiceBox" />

                <TextBlock Text="Live voice responsiveness (turn-end / VAD)" Foreground="#9AA3B5" FontSize="11" Margin="0,12,0,0" />
                <ComboBox x:Name="ResponsivenessCombo" Margin="0,2,0,4">
                    <ComboBoxItem Content="Fast replies — shortest pause before the counselor speaks" />
                    <ComboBoxItem Content="Balanced" />
                    <ComboBoxItem Content="Don't cut me off — longer pause; replies feel slower" />
                </ComboBox>
                <TextBlock TextWrapping="Wrap" Foreground="#6B7588" FontSize="10" Margin="0,0,0,8"
                           Text="Shorter pause feels more like live chat; longer pause helps if you stop mid-sentence. “Heard” text can still lag—that’s input transcription after your turn, not this setting." />

                <CheckBox x:Name="ShowRealtimeDiagBox" Content="Show live voice turn-state strip (listening → speaking…)" />
                <CheckBox x:Name="LogTimingsBox" Content="Log turn timings to Trace (Visual Studio Output / Debug)" />

                <CheckBox x:Name="AutoReadAloudBox" Content="Auto read-aloud replies" />
                <CheckBox x:Name="PreferOpenAiTtsBox" Content="Prefer OpenAI TTS (else Windows TTS when not headset-only)" />
                <CheckBox x:Name="HeadsetOnlyBox" Content="Headset-only / private output mode" />

                <TextBlock Text="Headset name substring (friendly name match)" Foreground="#9AA3B5" FontSize="11" Margin="0,12,0,0" />
                <TextBox x:Name="HeadsetMatchBox" />

                <TextBlock Text="Preferred output device ID (optional, from Windows)" Foreground="#9AA3B5" FontSize="11" />
                <TextBox x:Name="OutputIdBox" />

                <TextBlock Text="Preferred input device ID (Realtime live voice + optional; else headset name match in private mode, else Windows default mic)" Foreground="#9AA3B5" FontSize="11" TextWrapping="Wrap" />
                <TextBox x:Name="InputIdBox" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancel" Width="100" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="Save" Width="100" IsDefault="True" Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
