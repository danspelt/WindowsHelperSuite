<Window x:Class="WindowsHelperSuite.Overlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Width="Auto"
        Height="Auto"
        SizeToContent="WidthAndHeight"
        MaxWidth="720"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern dark palette with depth -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#0F0F14"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#1A1B23"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1F2A"/>
        <SolidColorBrush x:Key="CardHover" Color="#252636"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4ADE80"/>
        <SolidColorBrush x:Key="AccentGreenDim" Color="#2A5A3E"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#60A5FA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextMuted" Color="#4B5563"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2B36"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#222330"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A78BFA"/>
        <SolidColorBrush x:Key="ContextBackground" Color="#16171F"/>
        <SolidColorBrush x:Key="AccentStripe" Color="#4ADE80"/>

        <!-- Suggestion button style — modern card, large targets, high contrast -->
        <Style x:Key="SuggestionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12,18,12"/>
            <Setter Property="MinWidth" Value="76"/>
            <Setter Property="MinHeight" Value="48"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentGreenDim}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBackground}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Number badge — pill shape, bold -->
        <Style x:Key="SlotBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,3"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="26"/>
            <Setter Property="MinHeight" Value="26"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Shadow wrapper -->
    <Border Background="Transparent"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                            BlurRadius="36"
                            ShadowDepth="8"
                            Opacity="0.5"
                            Direction="270"/>
        </Border.Effect>

        <Grid>
            <!-- Main overlay border + inner glass edge -->
            <Border x:Name="OverlayBorder"
                    Background="{DynamicResource PrimaryBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="18,14,18,14"
                    MinHeight="88">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                               Text="Suggestions"
                               FontSize="11"
                               FontWeight="SemiBold"
                               FontFamily="Segoe UI"
                               Foreground="{DynamicResource TextMuted}"
                               Margin="2,0,0,8"
                               Opacity="0.92"/>

                    <!-- Accent stripe -->
                    <Border Grid.Row="1"
                            Background="{DynamicResource AccentStripe}"
                            Height="3"
                            CornerRadius="2"
                            Margin="0,0,0,12"
                            Opacity="0.75"/>

                    <!-- Context mode indicator -->
                    <Border x:Name="ContextBanner"
                            Grid.Row="2"
                            Background="{DynamicResource ContextBackground}"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ContextLabel"
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentPurple}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="620"/>
                    </Border>

                    <!-- Suggestions Container -->
                    <StackPanel x:Name="SuggestionsContainer"
                                Grid.Row="3"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                    </StackPanel>

                    <!-- Footer: paging + keyboard hints -->
                    <Border Grid.Row="4"
                            Margin="0,12,0,0"
                            Padding="0,10,0,0"
                            BorderThickness="0,1,0,0"
                            BorderBrush="{DynamicResource BorderSubtle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Paging indicator -->
                        <TextBlock x:Name="PagingIndicator"
                                   Grid.Column="0"
                                   Text=""
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- Speaker indicator (shown briefly when TTS plays) -->
                        <TextBlock x:Name="SpeakerIndicator"
                                   Grid.Column="1"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Foreground="{DynamicResource AccentBlue}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0"/>

                        <!-- Keyboard hints -->
                        <TextBlock Grid.Column="2"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Foreground="{DynamicResource TextMuted}"
                                   VerticalAlignment="Center"
                                   TextWrapping="NoWrap">
                            <Run Text="Press " Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text="1" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                            <Run Text="–" Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text="9" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                            <Run Text=" pick · " Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text="0" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"/>
                            <Run Text=" next · " Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text="-" FontWeight="Bold" Foreground="{DynamicResource AccentBlue}"/>
                            <Run Text=" prev · " Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text="Esc" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text=" close · " Foreground="{DynamicResource TextSecondary}"/>
                            <Run Text="`" FontWeight="Bold" Foreground="{DynamicResource AccentPurple}"/>
                            <Run Text=" refresh" Foreground="{DynamicResource TextSecondary}"/>
                        </TextBlock>
                    </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
