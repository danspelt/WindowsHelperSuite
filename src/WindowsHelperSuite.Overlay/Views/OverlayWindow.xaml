<Window x:Class="WindowsHelperSuite.Overlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Width="Auto"
        Height="Auto"
        SizeToContent="WidthAndHeight"
        MaxWidth="660"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextHintingMode="Animated"
        SnapsToDevicePixels="True"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Modern dark palette with depth -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#0F0F14"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#1A1B23"/>
        <SolidColorBrush x:Key="CardBackground" Color="#1E1F2A"/>
        <SolidColorBrush x:Key="CardHover" Color="#252636"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#4ADE80"/>
        <SolidColorBrush x:Key="AccentGreenDim" Color="#2A5A3E"/>
        <SolidColorBrush x:Key="AccentBlue" Color="#60A5FA"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#F0F0F5"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#6B7280"/>
        <SolidColorBrush x:Key="TextMuted" Color="#4B5563"/>
        <SolidColorBrush x:Key="BorderColor" Color="#2A2B36"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#222330"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#A78BFA"/>
        <SolidColorBrush x:Key="ContextBackground" Color="#16171F"/>
        <SolidColorBrush x:Key="AccentStripe" Color="#4ADE80"/>

        <!-- Suggestion button style — modern card, large targets, high contrast -->
        <Style x:Key="SuggestionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10,16,10"/>
            <Setter Property="MinWidth" Value="72"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            TextBlock.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Number badge — pill shape, bold -->
        <Style x:Key="SlotBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource AccentGreen}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="7,2"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <!-- Shadow wrapper -->
    <Border Background="Transparent"
            Margin="10">
        <Border.Effect>
            <DropShadowEffect Color="#000000"
                            BlurRadius="28"
                            ShadowDepth="6"
                            Opacity="0.55"
                            Direction="270"/>
        </Border.Effect>

        <!-- Outer clip for accent stripe -->
        <Grid>
            <!-- Main overlay border -->
            <Border x:Name="OverlayBorder"
                    Background="{StaticResource PrimaryBackground}"
                    BorderBrush="{StaticResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16,12,16,12"
                    MinHeight="80">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Accent stripe at top -->
                    <Border Grid.Row="0"
                            Background="{StaticResource AccentStripe}"
                            Height="3"
                            CornerRadius="2"
                            Margin="0,0,0,12"
                            Opacity="0.6"/>

                    <!-- Context mode indicator -->
                    <Border x:Name="ContextBanner"
                            Grid.Row="1"
                            Background="{StaticResource ContextBackground}"
                            CornerRadius="8"
                            Padding="10,6"
                            Margin="0,0,0,12"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ContextLabel"
                                   FontSize="12"
                                   FontFamily="Segoe UI"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentPurple}"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   MaxWidth="620"/>
                    </Border>

                    <!-- Suggestions Container -->
                    <StackPanel x:Name="SuggestionsContainer"
                                Grid.Row="2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                    </StackPanel>

                    <!-- Footer: paging + keyboard hints -->
                    <Grid Grid.Row="3" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Paging indicator -->
                        <TextBlock x:Name="PagingIndicator"
                                   Grid.Column="0"
                                   Text=""
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>

                        <!-- Speaker indicator (shown briefly when TTS plays) -->
                        <TextBlock x:Name="SpeakerIndicator"
                                   Grid.Column="1"
                                   FontSize="11"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource AccentBlue}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Opacity="0"/>

                        <!-- Keyboard hints -->
                        <TextBlock Grid.Column="2"
                                   Text="1-9 pick · 0/- page · Esc close"
                                   FontSize="10.5"
                                   FontFamily="Segoe UI"
                                   Foreground="{StaticResource TextMuted}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
