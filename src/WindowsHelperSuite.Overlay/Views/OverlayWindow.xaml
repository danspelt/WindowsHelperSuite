<Window x:Class="WindowsHelperSuite.Overlay.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Width="Auto"
        Height="Auto"
        SizeToContent="WidthAndHeight"
        MaxWidth="780"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        SnapsToDevicePixels="True"
        RenderOptions.ClearTypeHint="Enabled"
        FontFamily="Segoe UI">

    <Window.Resources>
        <!-- Red and green theme palette with maximum transparency -->
        <SolidColorBrush x:Key="PrimaryBackground" Color="#000A0F0A"/>
        <SolidColorBrush x:Key="SecondaryBackground" Color="#001A2B1A"/>
        <SolidColorBrush x:Key="CardBackground" Color="#0A1F3A1F"/>
        <SolidColorBrush x:Key="CardHover" Color="#0F2A4A2A"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00FF00"/>
        <Color x:Key="AccentGreenColor">#FF00FF00</Color>
        <SolidColorBrush x:Key="AccentGreenDim" Color="#201A4A1A"/>
        <SolidColorBrush x:Key="AccentRed" Color="#FF4444"/>
        <SolidColorBrush x:Key="TextPrimary" Color="#E0FFE0"/>
        <SolidColorBrush x:Key="TextSecondary" Color="#90C090"/>
        <SolidColorBrush x:Key="TextMuted" Color="#608060"/>
        <SolidColorBrush x:Key="BorderColor" Color="#153A5A3A"/>
        <SolidColorBrush x:Key="BorderSubtle" Color="#0A2A3A2A"/>
        <SolidColorBrush x:Key="AccentStripe" Color="#00FF00"/>

        <!-- Glow effects for high-confidence suggestions -->
        <DropShadowEffect x:Key="GlowEffect" Color="#00FF00" BlurRadius="20" ShadowDepth="0" Opacity="0.0"/>
        <DropShadowEffect x:Key="GlowEffectActive" Color="#00FF00" BlurRadius="25" ShadowDepth="0" Opacity="0.35"/>
        <DropShadowEffect x:Key="GlowEffectSubtle" Color="#FF4444" BlurRadius="15" ShadowDepth="0" Opacity="0.2"/>

        <!-- Suggestion button style — modern card, large targets, high contrast -->
        <Style x:Key="SuggestionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,11,20,11"/>
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="MinHeight" Value="56"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Effect" Value="{StaticResource GlowEffect}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Glow layer -->
                            <Border x:Name="glowBorder"
                                    Background="Transparent"
                                    CornerRadius="12"
                                    SnapsToDevicePixels="True"
                                    Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="glowShadow"
                                                      Color="#00FF00"
                                                      BlurRadius="20"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Border.Effect>
                            </Border>
                            <!-- Main content -->
                            <Border x:Name="border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="14"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000"
                                                      BlurRadius="16"
                                                      ShadowDepth="2"
                                                      Opacity="0.38"
                                                      Direction="270"/>
                                </Border.Effect>
                                <ContentPresenter HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                TextBlock.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource CardHover}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentGreenDim}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SecondaryBackground}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentGreen}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Number badge — pill shape, bold -->
        <Style x:Key="SlotBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentGreen}"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="9,5"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
            <Setter Property="MinWidth" Value="30"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="Auto"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="OverlayRootGrid"
          Background="Transparent"
          Margin="6"
          MouseEnter="OverlayRoot_MouseEnter"
          MouseLeave="OverlayRoot_MouseLeave">
            <Border x:Name="OverlayBorder"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="OverlayStatusHint"
                               Grid.Row="0"
                               FontSize="12"
                               FontFamily="Segoe UI"
                               Foreground="#C4A35A"
                               TextWrapping="Wrap"
                               MaxWidth="640"
                               Margin="2,0,0,6"
                               Visibility="Collapsed"/>

                    <!-- Suggestions Container -->
                    <StackPanel x:Name="SuggestionsContainer"
                                Grid.Row="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">
                    </StackPanel>

                    <!-- Kept for code-behind; not shown (footer removed) -->
                    <TextBlock x:Name="PagingIndicator" Grid.Row="1" Visibility="Collapsed" Height="0"/>
                    <TextBlock x:Name="SpeakerIndicator" Grid.Row="1" Visibility="Collapsed" Height="0"/>
                </Grid>
            </Border>

            <!-- Close button — hover-reveal, top-right corner -->
            <Button x:Name="CloseButton"
                    Click="CloseButton_Click"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="32"
                    Height="32"
                    Margin="0,2,2,0"
                    Cursor="Hand"
                    Focusable="False"
                    ToolTip="Close (Esc)"
                    Opacity="0">
                <Button.RenderTransform>
                    <TranslateTransform/>
                </Button.RenderTransform>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="bg"
                                     Fill="#E11D48"
                                     Stroke="#FFFFFF"
                                     StrokeThickness="1.5"
                                     Opacity="0.92"/>
                            <Ellipse Fill="Transparent"
                                     Width="18" Height="18"/>
                            <TextBlock Text="&#x2715;"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#FB7185"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bg" Property="Fill" Value="#BE123C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
    </Grid>
</Window>
