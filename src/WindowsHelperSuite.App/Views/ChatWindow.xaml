<Window x:Class="WindowsHelperSuite.App.Views.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowsHelperSuite.App.ViewModels"
        Title="AI Chat"
        Width="900" Height="680"
        MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#0F0F1A" Foreground="White"
        FontFamily="Segoe UI"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True">

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Ctrl" Command="{Binding NewChatCommand}"/>
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding ClearChatCommand}"/>
        <KeyBinding Key="Escape" Command="{Binding CancelGenerationCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/ChatStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- BoolToVisibility for cancel button -->
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" MinWidth="180" MaxWidth="340"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- SIDEBAR                                         -->
        <!-- ═══════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="{StaticResource Chat.Sidebar}">
            <DockPanel>
                <!-- Sidebar header: New Chat button -->
                <Border DockPanel.Dock="Top" Padding="14,16,14,12">
                    <Button Content="New Chat" Style="{StaticResource AccentBtn}"
                            HorizontalAlignment="Stretch"
                            Command="{Binding NewChatCommand}"/>
                </Border>

                <TextBlock DockPanel.Dock="Top" Text="RECENT CHATS" FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource Chat.TextDim}" Margin="18,6,18,8"/>

                <!-- Sidebar list -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="RecentChatsList" ItemsSource="{Binding RecentChats}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource SidebarItem}"
                                        Command="{Binding DataContext.LoadConversationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="{Binding Title}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"
                                                   Foreground="#C0C0DA" FontSize="13"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                            <TextBlock Text="{Binding MessageCount, StringFormat='{}{0} msgs'}"
                                                       Foreground="{StaticResource Chat.TextDim}" FontSize="11"/>
                                            <TextBlock Text=" · " Foreground="#44446A" FontSize="11"/>
                                            <TextBlock Text="{Binding TimeAgo}"
                                                       Foreground="{StaticResource Chat.TextDim}" FontSize="11"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Divider -->
        <Border Grid.Column="1" Background="{StaticResource Chat.Border}"/>

        <!-- ═══════════════════════════════════════════════ -->
        <!-- MAIN CHAT AREA: 4-row grid                      -->
        <!--   Row 0 = Header                                -->
        <!--   Row 1 = Messages (or empty state)             -->
        <!--   Row 2 = Status                                -->
        <!--   Row 3 = Composer                              -->
        <!-- ═══════════════════════════════════════════════ -->
        <Grid Grid.Column="2" Background="{StaticResource Chat.Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ─── ROW 0: HEADER ─── -->
            <Border Grid.Row="0" Padding="20,14,20,14"
                    Background="{StaticResource Chat.Sidebar}"
                    BorderBrush="#1A1A30" BorderThickness="0,0,0,1">
                <DockPanel>
                    <!-- Title on left -->
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="AI Chat" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource Chat.TextPrimary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" — " Foreground="{StaticResource Chat.TextDim}"
                                   FontSize="16" VerticalAlignment="Center" Margin="4,0"/>
                        <TextBlock Text="{Binding ChatTitle}" FontSize="16"
                                   Foreground="{StaticResource Chat.TextSecondary}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   MaxWidth="280"/>
                    </StackPanel>

                    <!-- Buttons on right -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="New Chat" Style="{StaticResource ChatBtn}" Margin="0,0,8,0"
                                Command="{Binding NewChatCommand}"/>
                        <Button Content="Copy Last" Style="{StaticResource ChatBtn}" Margin="0,0,8,0"
                                Command="{Binding CopyLastResponseCommand}"/>
                        <Button Content="Clear" Style="{StaticResource DangerBtn}"
                                Command="{Binding ClearChatCommand}" Margin="0,0,8,0"/>
                        <Button Content="Settings" Style="{StaticResource ChatBtn}"
                                Command="{Binding OpenSettingsCommand}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ─── ROW 1: EMPTY STATE (shown when no messages) ─── -->
            <Border Grid.Row="1"
                    Visibility="{Binding EmptyStateVisibility}"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <StackPanel HorizontalAlignment="Center" Margin="40">
                    <TextBlock Text="💬" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                    <TextBlock Text="Start a new conversation"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{StaticResource Chat.TextSecondary}"
                               HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <TextBlock Text="Ask for help with writing, ideas, phrases, or everyday tasks."
                               FontSize="16" Foreground="{StaticResource Chat.TextDim}"
                               HorizontalAlignment="Center" TextWrapping="Wrap"
                               TextAlignment="Center" MaxWidth="400"/>
                    <TextBlock Text="Type a message below to get started."
                               FontSize="14" Foreground="{StaticResource Chat.TextMuted}"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>

            <!-- ─── ROW 1: MESSAGE LIST (shown when messages exist) ─── -->
            <ListBox Grid.Row="1" x:Name="MessageList"
                     ItemsSource="{Binding Messages}"
                     Visibility="{Binding MessageListVisibility}"
                     Background="Transparent" BorderThickness="0"
                     Margin="20,8,20,8"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="False"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     SelectionMode="Single"
                     HorizontalContentAlignment="Stretch"
                     FocusVisualStyle="{x:Null}">

                <!-- Remove default ListBoxItem chrome -->
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="MsgBorder" CornerRadius="14" Padding="18,14"
                                Margin="0,6" MaxWidth="700">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock x:Name="RoleLabel" FontSize="13" FontWeight="Bold"
                                               Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Timestamp}" FontSize="11"
                                               Foreground="{StaticResource Chat.TextDim}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                           FontSize="18" LineHeight="28"
                                           Foreground="{StaticResource Chat.TextPrimary}"/>
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsUser}" Value="True">
                                <Setter TargetName="MsgBorder" Property="Background"
                                        Value="{StaticResource Chat.UserBubble}"/>
                                <Setter TargetName="MsgBorder" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="MsgBorder" Property="BorderBrush"
                                        Value="{StaticResource Chat.UserBorder}"/>
                                <Setter TargetName="MsgBorder" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="RoleLabel" Property="Text" Value="You"/>
                                <Setter TargetName="RoleLabel" Property="Foreground" Value="#8888CC"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsAssistant}" Value="True">
                                <Setter TargetName="MsgBorder" Property="Background"
                                        Value="{StaticResource Chat.AssistantBubble}"/>
                                <Setter TargetName="MsgBorder" Property="HorizontalAlignment" Value="Left"/>
                                <Setter TargetName="MsgBorder" Property="BorderBrush"
                                        Value="{StaticResource Chat.AssistantBorder}"/>
                                <Setter TargetName="MsgBorder" Property="BorderThickness" Value="1"/>
                                <Setter TargetName="RoleLabel" Property="Text" Value="Assistant"/>
                                <Setter TargetName="RoleLabel" Property="Foreground"
                                        Value="{StaticResource Chat.Accent}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsStreaming}" Value="True">
                                <Setter TargetName="MsgBorder" Property="BorderBrush"
                                        Value="{StaticResource Chat.StreamingBorder}"/>
                                <Setter TargetName="MsgBorder" Property="BorderThickness" Value="2"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- ─── ROW 2: STATUS ROW ─── -->
            <Border Grid.Row="2" Padding="20,0,20,6">
                <StackPanel>
                    <!-- Error bar -->
                    <Border x:Name="ErrorBar" Background="{StaticResource Chat.ErrorBg}"
                            CornerRadius="8" Padding="16,10" Margin="0,0,0,6"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorText"
                                   Foreground="{StaticResource Chat.ErrorFg}"
                                   FontSize="14" TextWrapping="Wrap"/>
                    </Border>

                    <!-- Status text + keyboard hints -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left"
                                   Text="{Binding StatusText}"
                                   FontSize="13"
                                   Foreground="{StaticResource Chat.TextDim}"
                                   VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   FontSize="11" Foreground="{StaticResource Chat.TextMuted}"
                                   VerticalAlignment="Center">
                            Enter = Send · Shift+Enter = New line · Esc = Stop · Ctrl+N / Ctrl+L
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ─── ROW 3: COMPOSER ─── -->
            <Border Grid.Row="3" Padding="20,10,20,18"
                    Background="{StaticResource Chat.Sidebar}"
                    BorderBrush="#1A1A30" BorderThickness="0,1,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Input box -->
                    <Border Grid.Column="0" CornerRadius="12"
                            Background="{StaticResource Chat.Surface2}"
                            BorderBrush="{StaticResource Chat.Border}" BorderThickness="1">
                        <TextBox x:Name="InputBox"
                                 Style="{StaticResource ComposerInput}"
                                 Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                                 PreviewKeyDown="InputBox_PreviewKeyDown"/>
                    </Border>

                    <!-- Buttons -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0"
                                VerticalAlignment="Bottom">
                        <Button Content="Send" Style="{StaticResource AccentBtn}"
                                Command="{Binding SendCommand}"
                                Margin="0,0,0,8"/>
                        <Button x:Name="CancelBtn" Content="Stop"
                                Style="{StaticResource DangerBtn}"
                                Command="{Binding CancelGenerationCommand}"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</Window>
