<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════ COLOR PALETTE ═══════ -->
    <SolidColorBrush x:Key="Chat.Accent"          Color="#6B6BE0"/>
    <SolidColorBrush x:Key="Chat.AccentDim"        Color="#4848B0"/>
    <SolidColorBrush x:Key="Chat.Background"       Color="#0F0F1A"/>
    <SolidColorBrush x:Key="Chat.Surface"          Color="#1C1C30"/>
    <SolidColorBrush x:Key="Chat.Surface2"         Color="#16162C"/>
    <SolidColorBrush x:Key="Chat.Sidebar"          Color="#0C0C18"/>
    <SolidColorBrush x:Key="Chat.Border"           Color="#2A2A48"/>
    <SolidColorBrush x:Key="Chat.TextPrimary"      Color="#E8E8F0"/>
    <SolidColorBrush x:Key="Chat.TextSecondary"    Color="#8888AA"/>
    <SolidColorBrush x:Key="Chat.TextDim"          Color="#55558A"/>
    <SolidColorBrush x:Key="Chat.TextMuted"        Color="#3A3A5C"/>
    <SolidColorBrush x:Key="Chat.UserBubble"       Color="#1E1E3C"/>
    <SolidColorBrush x:Key="Chat.UserBorder"       Color="#2A2A50"/>
    <SolidColorBrush x:Key="Chat.AssistantBubble"  Color="#141428"/>
    <SolidColorBrush x:Key="Chat.AssistantBorder"  Color="#22223C"/>
    <SolidColorBrush x:Key="Chat.StreamingBorder"  Color="#4848B0"/>
    <SolidColorBrush x:Key="Chat.ErrorBg"          Color="#2A1420"/>
    <SolidColorBrush x:Key="Chat.ErrorFg"          Color="#F0A0B0"/>
    <SolidColorBrush x:Key="Chat.DangerBg"         Color="#3A1E2A"/>
    <SolidColorBrush x:Key="Chat.DangerHover"      Color="#502A3A"/>
    <SolidColorBrush x:Key="Chat.DangerPress"      Color="#2A141E"/>

    <!-- ═══════ SPACING CONSTANTS ═══════ -->
    <Thickness x:Key="Chat.PagePadding">20,0,20,0</Thickness>
    <Thickness x:Key="Chat.SectionPadding">20,14</Thickness>
    <Thickness x:Key="Chat.BubbleMargin">0,6</Thickness>
    <Thickness x:Key="Chat.BubblePadding">18,14</Thickness>
    <CornerRadius x:Key="Chat.BubbleRadius">14</CornerRadius>
    <CornerRadius x:Key="Chat.ButtonRadius">10</CornerRadius>
    <CornerRadius x:Key="Chat.InputRadius">12</CornerRadius>
    <sys:Double x:Key="Chat.BubbleMaxWidth" xmlns:sys="clr-namespace:System;assembly=mscorlib">700</sys:Double>
    <sys:Double x:Key="Chat.ContentFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>
    <sys:Double x:Key="Chat.ComposerFontSize" xmlns:sys="clr-namespace:System;assembly=mscorlib">18</sys:Double>

    <!-- ═══════ BUTTON: Default ═══════ -->
    <Style x:Key="ChatBtn" TargetType="Button">
        <Setter Property="Background" Value="#252542"/>
        <Setter Property="Foreground" Value="#C0C0DA"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource Chat.ButtonRadius}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="#2A2A48" BorderThickness="1">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#303058"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#3A3A60"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1A1A30"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.35"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6B6BE0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════ BUTTON: Accent (Send, New Chat) ═══════ -->
    <Style x:Key="AccentBtn" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="20,10"/>
        <Setter Property="MinWidth" Value="110"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource Chat.ButtonRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#4848B0" Offset="0"/>
                                <GradientStop Color="#6B6BE0" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.88"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.92"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════ BUTTON: Danger (Clear, Stop) ═══════ -->
    <Style x:Key="DangerBtn" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource Chat.DangerBg}"/>
        <Setter Property="Foreground" Value="{StaticResource Chat.ErrorFg}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="{StaticResource Chat.ButtonRadius}"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Chat.DangerHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Chat.DangerPress}"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Chat.DangerHover}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════ BUTTON: Sidebar item ═══════ -->
    <Style x:Key="SidebarItem" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#C0C0DA"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="8" Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}" Margin="6,1">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E1E38"/>
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#1E1E38"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ═══════ SCROLLBAR: Thin dark ═══════ -->
    <Style x:Key="ChatScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="Background" Value="Transparent"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height" Value="6"/>
                <Setter Property="Width" Value="Auto"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ═══════ TEXTBOX: Composer input ═══════ -->
    <Style x:Key="ComposerInput" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="#E8E8F0"/>
        <Setter Property="CaretBrush" Value="#A8A8E8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,14"/>
        <Setter Property="FontSize" Value="{StaticResource Chat.ComposerFontSize}"/>
        <Setter Property="AcceptsReturn" Value="True"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MinHeight" Value="80"/>
        <Setter Property="MaxHeight" Value="180"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>

</ResourceDictionary>
