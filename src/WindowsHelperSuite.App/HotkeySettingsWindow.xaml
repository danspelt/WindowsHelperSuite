<Window x:Class="WindowsHelperSuite.App.HotkeySettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WindowsHelperSuite.App"
        Title="Settings — Windows Helper Suite"
        Width="720" Height="720"
        MinWidth="540" MinHeight="460"
        Background="#0F0F1A"
        Foreground="White"
        BorderThickness="0"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        FontFamily="Segoe UI"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6A6A92"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ActionBtn" TargetType="Button">
            <Setter Property="Background" Value="#252542"/>
            <Setter Property="Foreground" Value="#9090C0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#363660"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1C1C38"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#44445A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Background" Value="#3A3A9E"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4A4AB8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2A2A80"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ClearBtn" TargetType="Button" BasedOn="{StaticResource ActionBtn}">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Foreground" Value="#664466"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#CC66AA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ComboBox: full template + OverridesDefaultStyle so Windows theme cannot force light surfaces -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Foreground" Value="#EEEEF8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBd" Background="#1E1E34" Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter TextElement.Foreground="#EEEEF8"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#34345C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBd" Property="Background" Value="#3F3F82"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Background" Value="#16162C"/>
            <Setter Property="Foreground" Value="#F4F4FC"/>
            <Setter Property="BorderBrush" Value="#4A4A78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Closed field: dark fill behind text (OS theme was painting light gray here) -->
                            <Border x:Name="FieldBg" Grid.ColumnSpan="2"
                                    Background="#16162C" BorderBrush="#4A4A78" BorderThickness="1" CornerRadius="2"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Grid.Column="0"
                                              Margin="12,0,30,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              RecognizesAccessKey="True"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="#F4F4FC"/>
                            <ToggleButton x:Name="ToggleButton"
                                          Grid.ColumnSpan="2"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" BorderThickness="0"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Path Grid.Column="1"
                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Margin="0,0,12,0" Width="10" Height="6" Stretch="Uniform"
                                  Fill="#B8B8E0" Data="M 0,0 L 4,4 L 8,0 Z"
                                  IsHitTestVisible="False"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=TemplateRoot}"
                                   PopupAnimation="Fade">
                                <Border x:Name="DropDownBorder"
                                        MinWidth="{Binding ActualWidth, ElementName=TemplateRoot}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Background="#1A1A2E"
                                        BorderBrush="#4A4A78"
                                        BorderThickness="1"
                                        CornerRadius="2"
                                        SnapsToDevicePixels="True">
                                    <ScrollViewer Margin="0,4" SnapsToDevicePixels="True"
                                                  HorizontalScrollBarVisibility="Auto"
                                                  VerticalScrollBarVisibility="Auto"
                                                  CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsFieldTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#12122A"/>
            <Setter Property="Foreground" Value="#F0F0FA"/>
            <Setter Property="CaretBrush" Value="#A8A8E8"/>
            <Setter Property="BorderBrush" Value="#4A4A78"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ═══ Custom Slider ═══ -->
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#5C5C98"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Border x:Name="TrackBackground" Grid.Row="1"
                                    Height="4" CornerRadius="2"
                                    Background="#1A1A34" Margin="5,0"
                                    VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2"
                                                        Background="#6B6BE0"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid>
                                                    <Ellipse x:Name="ThumbGlow" Width="22" Height="22"
                                                             Fill="#186B6BE0" Opacity="0"/>
                                                    <Ellipse x:Name="ThumbOuter" Width="16" Height="16"
                                                             Fill="#6B6BE0" Cursor="Hand"/>
                                                    <Ellipse Width="6" Height="6"
                                                             Fill="White" IsHitTestVisible="False"/>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbOuter" Property="Fill" Value="#8B8BF0"/>
                                                        <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbOuter" Property="Fill" Value="#5555CC"/>
                                                        <Setter TargetName="ThumbGlow" Property="Opacity" Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Custom CheckBox (Toggle Switch) ═══ -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="40" Height="22">
                                <Border x:Name="SwitchTrack" CornerRadius="11"
                                        Background="#2A2A48" BorderThickness="1"
                                        BorderBrush="#3A3A5C"/>
                                <Border x:Name="SwitchThumb" Width="16" Height="16"
                                        CornerRadius="8" Background="#6A6A90"
                                        HorizontalAlignment="Left" Margin="3,0,0,0"
                                        VerticalAlignment="Center"/>
                            </Grid>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#4848B0"/>
                                <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#6B6BE0"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#EEEEFF"/>
                                <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#343458"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#8A8AB0"/>
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="SwitchTrack" Property="Background" Value="#5858C8"/>
                                <Setter TargetName="SwitchThumb" Property="Background" Value="#FFFFFF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ═══ Custom ScrollBar (dark theme) ═══ -->
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid>
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border x:Name="ThumbBd" CornerRadius="4"
                                                        Background="#2A2A50" Margin="1,0"/>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#4A4A78"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="ThumbBd" Property="Background" Value="#6B6BE0"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#B8B8DC"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Grid Width="18" Height="18">
                                <Ellipse x:Name="Outer" Width="18" Height="18"
                                         Stroke="#4A4A78" StrokeThickness="1.5" Fill="Transparent"/>
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                         Fill="#6B6BE0" Opacity="0"/>
                            </Grid>
                            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="#6B6BE0"/>
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Outer" Property="Stroke" Value="#8B8BF0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">

        <!-- Header -->
        <Border DockPanel.Dock="Top" BorderBrush="#2A2A42" BorderThickness="0,0,0,1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#14141E" Offset="0"/>
                    <GradientStop Color="#12121C" Offset="0.6"/>
                    <GradientStop Color="#161628" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="22,18,22,16">
                <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="10" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3A3A9E" Offset="0"/>
                            <GradientStop Color="#6B6BE0" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <TextBlock Text="&#x2699;" FontSize="20" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Settings" FontSize="22" FontWeight="SemiBold" Foreground="#FAFAFF"/>
                    <TextBlock Text="Appearance, hotkeys, speech, writer, and saved words"
                               FontSize="12" Foreground="#7A7AA8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#2A2A42" BorderThickness="0,1,0,0" Padding="18,14">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="#12121C" Offset="0"/>
                    <GradientStop Color="#141424" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Button x:Name="ResetBtn" HorizontalAlignment="Left"
                        Content="↺  Reset to Defaults"
                        Style="{StaticResource ActionBtn}"
                        Click="ResetBtn_Click"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelBtn" Content="Cancel"
                            Style="{StaticResource ActionBtn}"
                            Margin="0,0,10,0"
                            Click="CancelBtn_Click"/>
                    <Button x:Name="SaveBtn" Content="Save Changes"
                            Style="{StaticResource PrimaryBtn}"
                            Padding="18,8"
                            Click="SaveBtn_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tab control -->
        <TabControl x:Name="MainTabs" Background="#0F0F1A" BorderThickness="0" Padding="0,4,0,0"
                    SelectionChanged="MainTabs_SelectionChanged">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="#8B8BB8"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter Property="Padding" Value="18,12"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="TabBd" Background="Transparent"
                                        CornerRadius="8,8,0,0"
                                        BorderThickness="0,0,0,2"
                                        BorderBrush="Transparent"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="TabBd" Property="Background" Value="#16162A"/>
                                        <Setter TargetName="TabBd" Property="BorderBrush" Value="#6B6BE0"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                    <MultiTrigger>
                                        <MultiTrigger.Conditions>
                                            <Condition Property="IsSelected" Value="False"/>
                                            <Condition Property="IsMouseOver" Value="True"/>
                                        </MultiTrigger.Conditions>
                                        <Setter TargetName="TabBd" Property="Background" Value="#141422"/>
                                        <Setter Property="Foreground" Value="#C8C8E8"/>
                                    </MultiTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ═══════════ GENERAL (overlay / theme) ═══════════ -->
            <TabItem Header="⚙  General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Background="#0F0F1A">
                    <StackPanel Margin="20,16,20,20">

                        <TextBlock Text="TEXT &amp; SIZE" Style="{StaticResource ColHeader}" Margin="0,0,0,10"/>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Font Size" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="Overlay suggestion text" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Slider x:Name="FontSizeSlider" Grid.Column="1"
                                        Minimum="8" Maximum="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="12,0,8,0" VerticalAlignment="Center"
                                        ValueChanged="FontSizeSlider_ValueChanged"/>
                                <Border Grid.Column="2" Background="#12122A" CornerRadius="6" Padding="6,4">
                                    <TextBlock x:Name="FontSizeLabel" Text="14"
                                               FontSize="13" FontFamily="Consolas"
                                               Foreground="#88BBFF" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Font Family" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="Overlay suggestion font" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="FontFamilyCombo" Grid.Column="1"
                                          Background="#12122A" Foreground="#88BBFF"
                                          FontSize="13" Padding="8,6"
                                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Font Weight" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="Suggestion text boldness" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="FontWeightCombo" Grid.Column="1"
                                          Background="#12122A" Foreground="#88BBFF"
                                          FontSize="13" Padding="8,6"
                                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="46"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Opacity" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="Lower = more see-through panel (host app behind overlay); text stays sharp" FontSize="11" Foreground="#55558A" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Slider x:Name="OpacitySlider" Grid.Column="1"
                                        Minimum="10" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                        Margin="12,0,8,0" VerticalAlignment="Center"
                                        ValueChanged="OpacitySlider_ValueChanged"/>
                                <Border Grid.Column="2" Background="#12122A" CornerRadius="6" Padding="6,4">
                                    <TextBlock x:Name="OpacityLabel" Text="100%"
                                               FontSize="12" FontFamily="Consolas"
                                               Foreground="#88BBFF" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Large Text Mode" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="Boosts font size by 50% for accessibility" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="LargeTextCheck" Grid.Column="1"
                                          VerticalAlignment="Center" Margin="12,0,0,0"
                                          Foreground="#88BBFF"/>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Overlay Layout" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="Horizontal shows suggestions side-by-side" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <RadioButton x:Name="LayoutAuto" Content="Auto"
                                                 Foreground="#9090C0" FontSize="13" Margin="0,0,10,0"
                                                 GroupName="Layout"/>
                                    <RadioButton x:Name="LayoutVertical" Content="Vertical"
                                                 Foreground="#9090C0" FontSize="13" Margin="0,0,12,0"
                                                 GroupName="Layout"/>
                                    <RadioButton x:Name="LayoutHorizontal" Content="Horizontal"
                                                 Foreground="#9090C0" FontSize="13"
                                                 GroupName="Layout"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Overlay vs caret" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="Place the suggestion bar above, below, or auto (prefer above)"
                                               FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="OverlayCaretPlacementCombo" Grid.Column="1" MinWidth="140"
                                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Multi-screen position" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="Which screen to show overlay on" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <ComboBox x:Name="OverlayScreenPreferenceCombo" Grid.Column="1" MinWidth="140"
                                          VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Show/hide fade (ms)" FontSize="14" Foreground="#D8D8F0"/>
                                    <TextBlock Text="0 = instant; default 110" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Slider x:Name="OverlayFadeMsSlider" Grid.Column="1" Minimum="0" Maximum="600" TickFrequency="10"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock x:Name="OverlayFadeMsLabel" Grid.Column="2" Text="110" Foreground="#88BBFF"
                                           FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="COLORS" Style="{StaticResource ColHeader}" Margin="0,0,0,10"/>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,14" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Accent Color" FontSize="14" Foreground="#D8D8F0"/>
                                        <TextBlock Text="Stripe, badges, and highlights" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border x:Name="AccentPreview" Width="32" Height="24" CornerRadius="5" Margin="0,0,8,0"
                                                Cursor="Hand" ToolTip="Click to pick color"
                                                MouseLeftButtonUp="AccentPreview_Click"/>
                                        <TextBox x:Name="AccentHex" Width="88" Background="#12122A"
                                                 Foreground="#88BBFF" BorderThickness="0"
                                                 FontFamily="Consolas" FontSize="13" Padding="6,4"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="AccentHex_TextChanged"/>
                                        <Button Content="■" FontSize="16" Padding="6,2" Margin="6,0,0,0"
                                                ToolTip="Open color picker"
                                                Click="AccentPick_Click"
                                                Style="{StaticResource ActionBtn}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel x:Name="AccentSwatches"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,14" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Background Color" FontSize="14" Foreground="#D8D8F0"/>
                                        <TextBlock Text="Overlay panel background" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border x:Name="BgPreview" Width="32" Height="24" CornerRadius="5" Margin="0,0,8,0"
                                                Cursor="Hand" ToolTip="Click to pick color"
                                                MouseLeftButtonUp="BgPreview_Click"/>
                                        <TextBox x:Name="BgHex" Width="88" Background="#12122A"
                                                 Foreground="#88BBFF" BorderThickness="0"
                                                 FontFamily="Consolas" FontSize="13" Padding="6,4"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="BgHex_TextChanged"/>
                                        <Button Content="■" FontSize="16" Padding="6,2" Margin="6,0,0,0"
                                                ToolTip="Open color picker"
                                                Click="BgPick_Click"
                                                Style="{StaticResource ActionBtn}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel x:Name="BgSwatches"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,14" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Card Color" FontSize="14" Foreground="#D8D8F0"/>
                                        <TextBlock Text="Suggestion button background" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border x:Name="CardPreview" Width="32" Height="24" CornerRadius="5" Margin="0,0,8,0"
                                                Cursor="Hand" ToolTip="Click to pick color"
                                                MouseLeftButtonUp="CardPreview_Click"/>
                                        <TextBox x:Name="CardHex" Width="88" Background="#12122A"
                                                 Foreground="#88BBFF" BorderThickness="0"
                                                 FontFamily="Consolas" FontSize="13" Padding="6,4"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="CardHex_TextChanged"/>
                                        <Button Content="■" FontSize="16" Padding="6,2" Margin="6,0,0,0"
                                                ToolTip="Open color picker"
                                                Click="CardPick_Click"
                                                Style="{StaticResource ActionBtn}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel x:Name="CardSwatches"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,14" Margin="0,0,0,6">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Text Color" FontSize="14" Foreground="#D8D8F0"/>
                                        <TextBlock Text="Suggestion label text" FontSize="11" Foreground="#55558A" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Border x:Name="TextPreview" Width="32" Height="24" CornerRadius="5" Margin="0,0,8,0"
                                                Cursor="Hand" ToolTip="Click to pick color"
                                                MouseLeftButtonUp="TextPreview_Click"/>
                                        <TextBox x:Name="TextHex" Width="88" Background="#12122A"
                                                 Foreground="#88BBFF" BorderThickness="0"
                                                 FontFamily="Consolas" FontSize="13" Padding="6,4"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="TextHex_TextChanged"/>
                                        <Button Content="■" FontSize="16" Padding="6,2" Margin="6,0,0,0"
                                                ToolTip="Open color picker"
                                                Click="TextPick_Click"
                                                Style="{StaticResource ActionBtn}"/>
                                    </StackPanel>
                                </Grid>
                                <WrapPanel x:Name="TextSwatches"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ HOTKEYS TAB ═══════════ -->
            <TabItem Header="⌨  Hotkeys">
                <DockPanel Background="#0F0F1A">
                    <Border DockPanel.Dock="Top" Padding="20,10,20,8">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#0E0E1C" Offset="0"/>
                                <GradientStop Color="#121228" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1E1E38" CornerRadius="6" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="Tip" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#6B6BE0"/>
                            </Border>
                            <TextBlock FontSize="12" Foreground="#6A6A92" VerticalAlignment="Center">
                                Click CHANGE, then press your desired key combo. Press Esc to cancel.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Top" Background="#0C0C18" Padding="20,6,20,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" Text="ACTION" Style="{StaticResource ColHeader}"/>
                            <TextBlock Grid.Column="2" Text="BINDING" Style="{StaticResource ColHeader}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Background="#0F0F1A">
                        <StackPanel x:Name="RowsPanel" Margin="8,6,8,12"/>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>

            <!-- ═══════════ SPEECH TAB ═══════════ -->
            <TabItem Header="🔊  Speech">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0F0F1A">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Text="SPEECH OUTPUT" Style="{StaticResource ColHeader}" Margin="0,0,0,4"/>
                        <TextBlock Text="Configure how suggestions are spoken aloud"
                                   FontSize="12" Foreground="#55558A" Margin="0,0,0,12"/>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speak when selecting suggestions" TextWrapping="Wrap" Foreground="#D8D8F0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="SpeechEnableSelection" Grid.Column="1" VerticalAlignment="Center" Foreground="#88BBFF"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speak when moving suggestion highlight (↑↓)" TextWrapping="Wrap" Foreground="#D8D8F0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="SpeechEnableHighlight" Grid.Column="1" VerticalAlignment="Center" Foreground="#88BBFF"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Highlight speech delay (ms)" VerticalAlignment="Center" Foreground="#D8D8F0" TextWrapping="Wrap"/>
                                <Slider x:Name="SpeechHighlightDebounceSlider" Grid.Column="1" Minimum="0" Maximum="2000" TickFrequency="50"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock x:Name="SpeechHighlightDebounceLabel" Grid.Column="2" Text="200" Foreground="#88BBFF"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" Foreground="#D8D8F0" VerticalAlignment="Center">
                                    <Run Text="Only when headset is default device"/>
                                    <LineBreak/>
                                    <Run Text="Uses device name heuristics; refreshes when the default output device changes." FontSize="10" Foreground="#6A6A92"/>
                                </TextBlock>
                                <CheckBox x:Name="SpeechHeadsetOnly" Grid.Column="1" VerticalAlignment="Center" Foreground="#88BBFF"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="40"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Speech rate" VerticalAlignment="Center" Foreground="#D8D8F0"/>
                                <Slider x:Name="SpeechRateSlider" Grid.Column="1" Minimum="-2" Maximum="2" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock x:Name="SpeechRateLabel" Grid.Column="2" Text="0" Foreground="#88BBFF"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Volume" VerticalAlignment="Center" Foreground="#D8D8F0"/>
                                <Slider x:Name="SpeechVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock x:Name="SpeechVolumeLabel" Grid.Column="2" Text="100" Foreground="#88BBFF"
                                           VerticalAlignment="Center" FontFamily="Consolas"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Speak mode" Foreground="#D8D8F0" Margin="0,0,0,6"/>
                                <ComboBox x:Name="SpeakModeCombo"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Voice mode" Foreground="#D8D8F0" Margin="0,0,0,6"/>
                                <ComboBox x:Name="VoiceModeCombo"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Azure / online voice name (optional)" Foreground="#D8D8F0" Margin="0,0,0,6"/>
                                <TextBox x:Name="SpeechVoiceNameBox" Style="{StaticResource SettingsFieldTextBox}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ WRITER TAB ═══════════ -->
            <TabItem Header="✍  Writer">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0F0F1A">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Text="OVERLAY &amp; TYPING" Style="{StaticResource ColHeader}" Margin="0,0,0,4"/>
                        <TextBlock Text="Control how the suggestion overlay appears and types"
                                   FontSize="12" Foreground="#55558A" Margin="0,0,0,12"/>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Auto-show suggestions" Foreground="#D8D8F0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="WriterAutoShow" Grid.Column="1" VerticalAlignment="Center" Foreground="#88BBFF"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Follow caret" Foreground="#D8D8F0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="WriterFollowCaret" Grid.Column="1" VerticalAlignment="Center" Foreground="#88BBFF"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Foreground="#D8D8F0" VerticalAlignment="Center" TextWrapping="Wrap">
                                    <Run Text="Window title phrase hints"/>
                                    <LineBreak/>
                                    <Run Text="Opt-in: boost phrases when the window title looks like web mail (titles are not logged)." FontSize="10" Foreground="#6A6A92"/>
                                </TextBlock>
                                <CheckBox x:Name="WriterTitleHints" Grid.Column="1" VerticalAlignment="Center" Foreground="#88BBFF"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Manual trigger key (display)" Foreground="#D8D8F0" Margin="0,0,0,6"/>
                                <TextBox x:Name="WriterManualKeyBox" Style="{StaticResource SettingsFieldTextBox}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Dock position" Foreground="#D8D8F0" Margin="0,0,0,6"/>
                                <TextBox x:Name="WriterDockBox" Style="{StaticResource SettingsFieldTextBox}"/>
                            </StackPanel>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Max suggestions" VerticalAlignment="Center" Foreground="#D8D8F0"/>
                                <Slider x:Name="WriterMaxSugSlider" Grid.Column="1" Minimum="3" Maximum="15" TickFrequency="1"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock x:Name="WriterMaxSugLabel" Grid.Column="2" Text="9" Foreground="#88BBFF" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="44"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Debounce (ms)" VerticalAlignment="Center" Foreground="#D8D8F0"/>
                                <Slider x:Name="WriterDebounceSlider" Grid.Column="1" Minimum="50" Maximum="500" TickFrequency="10"
                                        IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="8,0"/>
                                <TextBlock x:Name="WriterDebounceLabel" Grid.Column="2" Text="150" Foreground="#88BBFF" FontFamily="Consolas" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Auto-capitalize sentences" Foreground="#D8D8F0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="WriterAutoCap" Grid.Column="1" VerticalAlignment="Center" Foreground="#88BBFF"/>
                            </Grid>
                        </Border>
                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Capitalize single letter i → I" Foreground="#D8D8F0" VerticalAlignment="Center"/>
                                <CheckBox x:Name="WriterCapI" Grid.Column="1" VerticalAlignment="Center" Foreground="#88BBFF"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ═══════════ WORDS &amp; PHRASES ═══════════ -->
            <TabItem Header="🗣  Live Captions">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#0F0F1A">
                    <StackPanel Margin="20,16,20,20">
                        <TextBlock Text="OPENAI WHISPER (SPEECH-TO-TEXT)" Style="{StaticResource ColHeader}" Margin="0,0,0,4"/>
                        <TextBlock Text="These settings improve transcription accuracy for your voice. Phrase hints and example sentences can make a big difference."
                                   FontSize="12" Foreground="#55558A" Margin="0,0,0,12" TextWrapping="Wrap"/>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="OpenAI API key (optional; can also use OPENAI_API_KEY env var)" Foreground="#D8D8F0" Margin="0,0,0,6"/>
                                <TextBox x:Name="LiveCaptionsOpenAiApiKeyBox" Style="{StaticResource SettingsFieldTextBox}"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Whisper model" Foreground="#D8D8F0" Margin="0,0,0,6"/>
                                <ComboBox x:Name="LiveCaptionsWhisperModelCombo"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Base transcription prompt" Foreground="#D8D8F0" Margin="0,0,0,6"/>
                                <TextBox x:Name="LiveCaptionsWhisperPromptBox"
                                         Style="{StaticResource SettingsFieldTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="90"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Phrase hints (one per line)" Foreground="#D8D8F0" Margin="0,0,0,2"/>
                                <TextBlock Text="Add names, places, apps, medical terms, and phrases you say often."
                                           FontSize="11" Foreground="#6A6A92" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBox x:Name="LiveCaptionsWhisperPhraseHintsBox"
                                         Style="{StaticResource SettingsFieldTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="120"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#1C1C30" CornerRadius="8" Padding="16,12" Margin="0,0,0,6">
                            <StackPanel>
                                <TextBlock Text="Example sentences (one per line, optional)" Foreground="#D8D8F0" Margin="0,0,0,2"/>
                                <TextBlock Text="Write a few short sentences in the way you normally talk. This helps bias transcription toward your phrasing."
                                           FontSize="11" Foreground="#6A6A92" Margin="0,0,0,6" TextWrapping="Wrap"/>
                                <TextBox x:Name="LiveCaptionsWhisperExamplesBox"
                                         Style="{StaticResource SettingsFieldTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         MinHeight="120"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="📋  Words &amp; Phrases">
                <local:WordsPhrasesSettingsPanel x:Name="WordsPhrasesPanel" Margin="4"/>
            </TabItem>

        </TabControl>

    </DockPanel>
</Window>
